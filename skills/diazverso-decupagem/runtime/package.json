{
  "name": "diazverso-remotion-independent-smoke",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Remotion validation harness; no Content Lab and no posting",
  "scripts": {
    "test": "node --test tests/*.mjs",
    "render:still": "remotion still src/index.ts DiazversoSmoke out/smoke.png --frame=15 --overwrite=false",
    "render:clip": "remotion render src/index.ts DiazversoSmoke out/smoke.mp4 --frames=0-29 --codec=h264 --overwrite=false"
  },
  "dependencies": {
    "remotion": "4.0.542",
    "@remotion/cli": "4.0.542",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.8.3"
  }
}
