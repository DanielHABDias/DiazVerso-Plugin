{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diazverso Remotion composition contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "production_id",
    "script_version",
    "format",
    "fps",
    "width",
    "height",
    "duration_frames",
    "assets",
    "scenes",
    "output"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "production_id": {
      "type": "string",
      "pattern": "^(VD|SH)_[0-9]{4,}$"
    },
    "script_version": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "enum": [
        "LONGO",
        "SHORT"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "duration_frames": {
      "type": "integer",
      "minimum": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "kind",
          "rights"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "audio",
              "font"
            ]
          },
          "rights": {
            "enum": [
              "APPROVED",
              "PENDING"
            ]
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_frame",
          "duration_frames",
          "objective",
          "visual",
          "layers",
          "captions",
          "audio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2,4}$"
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "type": "string",
            "minLength": 1
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset_id",
                "motion",
                "z_index"
              ],
              "properties": {
                "asset_id": {
                  "type": "string",
                  "minLength": 1
                },
                "motion": {
                  "enum": [
                    "static",
                    "pan",
                    "zoom",
                    "reframe",
                    "parallax",
                    "kinetic-text"
                  ]
                },
                "z_index": {
                  "type": "integer"
                }
              }
            }
          },
          "captions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "start_frame",
                "duration_frames"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "start_frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_frames": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "audio": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset_id",
                "start_frame",
                "duration_frames",
                "volume"
              ],
              "properties": {
                "asset_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start_frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_frames": {
                  "type": "integer",
                  "minimum": 1
                },
                "volume": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basename",
        "container",
        "video_codec"
      ],
      "properties": {
        "basename": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "container": {
          "const": "mp4"
        },
        "video_codec": {
          "const": "h264"
        }
      }
    }
  }
}
